---
import PengoLayout from "../../layouts/PengoLayout.astro";
---

<PengoLayout
  title="Terms | Pengo Systems"
  description="Terms for using the Pengo Systems website and public materials."
  url="https://pengosystems.com/terms/"
>
  <main class="site-page">
    <section class="site-page-content">
      <p class="eyebrow">Terms</p>
      <h1>Terms</h1>
      <p class="lede">
        Terms for using the Pengo Systems website and public materials.
      </p>

      <section>
        <h2>Use of This Site</h2>
        <p>
          You may browse and use public Pengo Systems pages for information,
          reference, and communication.
        </p>
      </section>

      <section>
        <h2>Site Content</h2>
        <p>
          Site content may include product descriptions, reference material,
          Workbench pages, machine-readable exports, articles, notes, and other
          materials. Content may change over time.
        </p>
      </section>

      <section>
        <h2>Intellectual Property</h2>
        <p>
          Pengo Systems owns its names, marks, site content, Workbench materials,
          terminology, layouts, and related materials unless otherwise stated.
        </p>
      </section>

      <section>
        <h2>Workbench Material</h2>
        <p>
          Workbench-specific reference use, attribution, and responsibility terms
          are covered by <a href="/workbench/terms/">Workbench Terms</a> and
          <a href="/workbench/use-attribution/">Use & Attribution</a>.
