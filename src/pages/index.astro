---
import PengoLayout from "../layouts/PengoLayout.astro";
---

<PengoLayout
  title="Pengo Systems"
  description="Diagnostic systems for automation and AI-era work."
  url="https://pengosystems.com/"
>
  <main>
    <section class="hero section-shell">
      <div class="hero-grid">
        <div class="hero-copy">
          <h1>Diagnostic systems for automation and AI-era work.</h1>
          <p class="hero-lede">
            PENGO builds products for the seams where work becomes action and consequences matter.
          </p>

          <div class="hero-actions">
            <a class="button button-primary" href="/workbench/">Open Workbench</a>
            <a class="button button-secondary" href="/about/">About PENGO</a>
          </div>
        </div>

        <div class="hero-visual" aria-hidden="true">
          <blockquote class="signal-card signal-quote">
            <span></span>
            <p>AI and automated systems do not absorb ambiguity. They execute it.</p>
            <cite>~ Pengo</cite>
          </blockquote>
        </div>
      </div>
    </section>

    <section class="split-section split-section-strong">
      <div class="section-shell split-grid">
        <div>
          <span class="section-chip">First public surface</span>
          <h2>Workbench</h2>
        </div>
        <div class="section-copy">
          <p>
            PENGO Workbench is the first public section from PENGO Systems. It provides a browsable reference for AI-related issues, recurring patterns, review lenses, and categories.
          </p>
          <a class="text-link" href="/workbench/">Explore Workbench</a>
        </div>
      </div>
    </section>

    <section class="split-section">
      <div class="section-shell split-grid">
        <div>
          <h2>Product direction</h2>
        </div>
        <div class="section-copy">
          <p>
            Additional PENGO products are being developed around checkpoints, observations, controls, receipts, and machine-to-machine work. This section is temporary and can be replaced when product sites are ready.
          </p>
        </div>
      </div>
    </section>

    <section class="split-section">
      <div class="section-shell split-grid">
        <div>
          <h2>Where work becomes action.</h2>
        </div>
        <div class="section-copy">
          <p>
            PENGO Systems builds products for the seams where software, automation, AI systems, and real-world consequences meet.
          </p>
          <a class="text-link" href="/about/">Read About</a>
        </div>
      </div>
    </section>
  </main>
</PengoLayout>
