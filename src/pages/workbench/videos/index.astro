---
import WorkbenchLayout from "../../../layouts/WorkbenchLayout.astro";
---

<WorkbenchLayout
  title="Video | PENGO Workbench"
  description="Video explainers, walkthroughs, and demonstrations for Workbench concepts and workflows."
  url="https://pengosystems.com/workbench/videos/"
  active="videos"
  breadcrumb="Video"
>
  <article class="wb-content wb-template">
    <p class="wb-type-label">Video</p>
    <h1>Video</h1>
    <p class="wb-lede">
      Explainers, walkthroughs, demonstrations, and visual introductions to Workbench concepts and workflows.
    </p>

    <section class="wb-reading-section">
      <h2>Planned Video Types</h2>
      <ul>
        <li>Check Input walkthroughs</li>
        <li>Explore Results demonstrations</li>
        <li>Pattern and Lens explainers</li>
        <li>Workbench navigation walkthroughs</li>
        <li>Machine-readable output explainers</li>
      </ul>
    </section>

    <section class="wb-reading-section">
      <h2>How to Read This</h2>
      <p>
        Videos are explanatory media. They may cite Workbench references, but they do not
        define canonical Issues, Patterns, Lenses, Categories, or validation rules.
      </p>
    </section>
  </article>
</WorkbenchLayout>
