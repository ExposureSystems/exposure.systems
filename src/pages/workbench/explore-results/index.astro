---
import WorkbenchLayout from "../../../layouts/WorkbenchLayout.astro";
import checkInputIndex from "../../../content/_meta/check-input-index.json";

const characterLimit = 12000;

const explorationData = checkInputIndex.results.map((result) => ({
  detectedGap: result.detected_gap,
  caveat: result.caveat,
  patterns: {
    primary: result.patterns.primary.map((pattern) => ({
      code: pattern.code,
      title: pattern.title,
      summary: pattern.summary,
      url: pattern.url,
      absoluteUrl: `https://pengosystems.com${pattern.url}`,
    })),
    secondary: result.patterns.secondary.map((pattern) => ({
      code: pattern.code,
      title: pattern.title,
      summary: pattern.summary,
      url: pattern.url,
      absoluteUrl: `https://pengosystems.com${pattern.url}`,
    })),
  },
  usefulLenses: result.useful_lenses.map((lens) => ({
    code: lens.code,
    title: lens.title,
    summary: lens.summary,
    url: lens.url,
    absoluteUrl: `https://pengosystems.com${lens.url}`,
  })),
}));
---

<WorkbenchLayout
  title="Explore Results | PENGO Workbench"
  description="Map Check Input output into related Workbench Patterns and useful Lenses."
  url="https://pengosystems.com/workbench/explore-results/"
  active="check-inputs"
  breadcrumbs={[
    { label: "Check Input", href: "/workbench/check-input/" },
    { label: "Explore Results" },
  ]}
>
  <article class="wb-content wb-template">
    <div class="wb-page-action">
      <a href="/workbench/check-input/">Check Input</a>
      <span aria-current="page">Explore Results</span>
    </div>

    <p class="wb-type-label">Input Mapping</p>
    <h1>Explore Results</h1>
    <p class="wb-lede">
      Bring the AI output back to PENGO and map it into the Workbench.
    </p>

    <section class="wb-reading-section">
      <h2>How This Works</h2>
      <ol>
        <li>Run Check Input with any AI.</li>
        <li>Bring the AI output back to PENGO.</li>
        <li>Paste the Input Summary and Detected Gaps below.</li>
        <li>Map the controlled gaps into related Patterns.</li>
        <li>Explore useful Lenses for those Patterns.</li>
      </ol>

      <p>
        These are related structural references, not a final diagnosis.
      </p>
    </section>

    <section class="wb-section" aria-label="Paste Check Input output">
      <h2>Map Your AI Output</h2>

      <div class="explore-input-grid">
        <div class="explore-input-panel">
          <label for="check-input-output">Paste Check Input output</label>
          <textarea
            id="check-input-output"
            rows="16"
            data-explore-input
            placeholder={`Input Summary
- actor: ...
- trigger: ...
- action: ...
- outcome: ...
- scope: ...
- constraint: ...
- dependency: ...
- sequence: ...

Detected Gaps
- missing actor
- unclear scope
- unstated constraint`}
          ></textarea>

          <p class="explore-warning" data-explore-warning hidden></p>

          <div class="explore-actions">
            <button type="button" data-map-results disabled>
              Map Into Workbench
            </button>
            <button type="button" data-copy-results hidden>
              Copy Workbench Results
            </button>
          </div>
        </div>

        <details class="explore-rules" open>
          <summary>Formatting Rules</summary>

          <div>
            <p>
              Paste plain text from Check Input.
            </p>
            <p>
              Mapped lines must match:
              <code>[gap type] [element]</code>
            </p>
            <ul>
              <li><code>missing actor</code></li>
              <li><code>unclear scope</code></li>
              <li><code>unstated constraint</code></li>
            </ul>
            <p>
              Freeform text is ignored. HTML and code are treated as plain text.
            </p>
            <p>
              Limit: {characterLimit.toLocaleString()} characters.
            </p>
          </div>
        </details>
      </div>
    </section>

    <section class="wb-section" data-results-section hidden>
      <h2>Mapped Results</h2>
      <div data-results-list></div>
    </section>

    <section class="wb-section" data-no-results-section hidden>
      <h2>No Controlled Gaps Found</h2>
      <p>
        No controlled Check Input gaps were found. Run Check Input first, then paste the Input Summary and Detected Gaps here.
      </p>
      <p class="wb-next-link">
        <a href="/workbench/check-input/">Open Check Input</a>
      </p>
    </section>

    <section class="wb-section" data-ignored-section hidden>
      <h2>Ignored Lines</h2>
      <p data-ignored-summary></p>
      <ul data-ignored-list></ul>
    </section>

    <section class="wb-reading-section">
      <h2>How to Read This</h2>
      <p>
        Explore Results does not prove why an AI system failed. It maps controlled Check Input output into related Workbench Patterns and Lenses so you can inspect the structure the original ask left open.
      </p>
    </section>
  </article>

  <script
    type="application/json"
    id="explore-results-data"
    set:html={JSON.stringify(explorationData)}
  ></script>

  <style>
    .explore-input-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(210px, 270px);
      gap: 1rem;
      align-items: start;
      margin-top: 1rem;
    }

    .explore-input-panel {
      border: 1px solid var(--color-border);
      border-radius: 18px;
      background: var(--color-surface);
      overflow: hidden;
    }

    .explore-input-panel label {
      display: block;
      padding: 0.8rem 0.95rem;
      border-bottom: 1px solid var(--color-border);
      color: var(--color-text);
      font-size: 0.82rem;
      line-height: 1.1;
      font-weight: 850;
    }

    .explore-input-panel textarea {
      display: block;
      width: 100%;
      min-height: 18rem;
      padding: 1rem;
      border: 0;
      resize: vertical;
      background: transparent;
      color: var(--color-text);
      font: 0.86rem/1.55 ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
      white-space: pre;
    }

    .explore-input-panel textarea:focus {
      outline: 2px solid var(--color-accent);
      outline-offset: -2px;
    }

    .explore-warning {
      margin: 0 !important;
      padding: 0 1rem 0.85rem;
      color: var(--color-accent) !important;
      font-size: 0.85rem !important;
      line-height: 1.4 !important;
      font-weight: 750 !important;
    }

    .explore-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.65rem;
      padding: 0.85rem 0.95rem;
      border-top: 1px solid var(--color-border);
    }

    .explore-actions button {
      appearance: none;
      border: 1px solid var(--color-accent);
      border-radius: 999px;
      background: transparent;
      color: var(--color-accent);
      padding: 0.5rem 0.8rem;
      font: inherit;
      font-size: 0.74rem;
      line-height: 1;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      cursor: pointer;
    }

    .explore-actions button:hover:not(:disabled) {
      background: var(--color-accent);
      color: var(--color-bg);
    }

    .explore-actions button:disabled {
      cursor: not-allowed;
      opacity: 0.42;
    }

    .explore-rules {
      border: 1px solid var(--color-border);
      border-radius: 18px;
      background: var(--color-surface);
      padding: 0.85rem 0.95rem;
    }

    .explore-rules summary {
      color: var(--color-text);
      cursor: pointer;
      font-size: 0.82rem;
      line-height: 1.2;
      font-weight: 850;
    }

    .explore-rules div {
      margin-top: 0.8rem;
    }

    .explore-rules p,
    .explore-rules li {
      font-size: 0.85rem !important;
      line-height: 1.45 !important;
    }

    .explore-url {
      margin-top: 0.18rem !important;
      color: var(--color-faint) !important;
      font-size: 0.72rem !important;
      line-height: 1.35 !important;
      word-break: break-all;
    }

    @media (max-width: 960px) {
      .explore-input-grid {
        display: flex;
        flex-direction: column;
      }

      .explore-input-panel,
      .explore-rules {
        width: 100%;
        max-width: 100%;
      }

      .explore-input-panel textarea {
        min-height: 14rem;
      }

      .explore-rules[open] {
        padding-bottom: 0.95rem;
      }
    }
  </style>

  <script>
    const DATA_LIMIT = 12000;
    const dataElement = document.getElementById("explore-results-data");
    const input = document.querySelector("[data-explore-input]");
    const warning = document.querySelector("[data-explore-warning]");
    const mapButton = document.querySelector("[data-map-results]");
    const copyButton = document.querySelector("[data-copy-results]");
    const resultsSection = document.querySelector("[data-results-section]");
    const noResultsSection = document.querySelector("[data-no-results-section]");
    const ignoredSection = document.querySelector("[data-ignored-section]");
    const resultsList = document.querySelector("[data-results-list]");
    const ignoredList = document.querySelector("[data-ignored-list]");
    const ignoredSummary = document.querySelector("[data-ignored-summary]");

    const explorationData = JSON.parse(dataElement?.textContent || "[]");
    const resultByGap = new Map(
      explorationData.map((item) => [item.detectedGap.toLowerCase(), item])
    );

    let lastCopyText = "";

    function normalizeLine(line) {
      return line
        .trim()
        .replace(/^[-*•]+\\s*/, "")
        .replace(/\s+/g, " ")
        .toLowerCase();
    }

    function updateInputState() {
      if (!(input instanceof HTMLTextAreaElement)) return;

      const overage = input.value.length - DATA_LIMIT;
      const hasText = input.value.trim().length > 0;

      if (overage > 0) {
        warning.hidden = false;
        warning.textContent = `-${overage.toLocaleString()} characters. Please reduce input size.`;
      } else {
        warning.hidden = true;
        warning.textContent = "";
      }

      if (mapButton instanceof HTMLButtonElement) {
        mapButton.disabled = !hasText || overage > 0;
      }
    }

    function clearChildren(element) {
      if (!element) return;
      while (element.firstChild) {
        element.removeChild(element.firstChild);
      }
    }

    function appendTextElement(parent, tagName, text, className) {
      const element = document.createElement(tagName);
      element.textContent = text;
      if (className) {
        element.className = className;
      }
      parent.appendChild(element);
      return element;
    }

    function appendRow(parent, item, surfacedBy = []) {
      const row = document.createElement("a");
      row.className = "wb-row";
      row.href = item.url;

      const code = appendTextElement(row, "p", item.code, "wb-row-meta");
      code.setAttribute("translate", "no");
      code.classList.add("notranslate");
      code.setAttribute("lang", "en");

      const title = document.createElement("h2");
      const titleSpan = appendTextElement(title, "span", item.title, "notranslate");
      titleSpan.setAttribute("translate", "no");
      titleSpan.setAttribute("lang", "en");
      row.appendChild(title);

      const urlText = item.absoluteUrl.replace("https://", "");
      appendTextElement(row, "p", urlText, "explore-url");

      if (surfacedBy.length > 0) {
        appendTextElement(row, "p", `Surfaced by: ${surfacedBy.join(", ")}`, "explore-url");
      }

      appendTextElement(row, "p", item.summary);

      parent.appendChild(row);
    }

    function addAggregateItem(map, item, detectedGap) {
      if (!map.has(item.code)) {
        map.set(item.code, {
          ...item,
          surfacedBy: [],
        });
      }

      const aggregate = map.get(item.code);

      if (!aggregate.surfacedBy.includes(detectedGap)) {
        aggregate.surfacedBy.push(detectedGap);
      }
    }

    function collectAggregates(mapped) {
      const patternMap = new Map();
      const lensMap = new Map();

      for (const result of mapped) {
        for (const pattern of result.patterns.primary) {
          addAggregateItem(patternMap, pattern, result.detectedGap);
        }

        for (const pattern of result.patterns.secondary) {
          addAggregateItem(patternMap, pattern, result.detectedGap);
        }

        for (const lens of result.usefulLenses) {
          addAggregateItem(lensMap, lens, result.detectedGap);
        }
      }

      return {
        patterns: Array.from(patternMap.values()),
        lenses: Array.from(lensMap.values()),
      };
    }

    function parseInput(value) {
      const mapped = [];
      const ignored = [];
      const seen = new Set();

      const rawLines = value.replaceAll("\r\n", "\n").replaceAll("\r", "\n").split("\n");

      for (const rawLine of rawLines) {
        const line = normalizeLine(rawLine);

        if (!line || line === "detected gaps" || line === "input summary") {
          continue;
        }

        if (resultByGap.has(line)) {
          if (!seen.has(line)) {
            mapped.push(resultByGap.get(line));
            seen.add(line);
          }
          continue;
        }

        if (rawLine.trim()) {
          ignored.push(rawLine.trim());
        }
      }

      return { mapped, ignored };
    }

    function buildCopyText(mapped) {
      const aggregates = collectAggregates(mapped);

      const lines = [
        "Explore Results",
        "",
        "Controlled gaps mapped:",
        ...mapped.map((item) => `- ${item.detectedGap}`),
        "",
        "Related Patterns:",
      ];

      for (const pattern of aggregates.patterns) {
        lines.push(`- ${pattern.code} - ${pattern.title}`);
        lines.push(`  ${pattern.absoluteUrl}`);
        lines.push(`  Surfaced by: ${pattern.surfacedBy.join(", ")}`);
        lines.push(`  ${pattern.summary}`);
      }

      lines.push("");
      lines.push("Useful Lenses:");

      for (const lens of aggregates.lenses) {
        lines.push(`- ${lens.code} - ${lens.title}`);
        lines.push(`  ${lens.absoluteUrl}`);
        lines.push(`  Surfaced by: ${lens.surfacedBy.join(", ")}`);
        lines.push(`  ${lens.summary}`);
      }

      lines.push("");
      lines.push("How to read this:");
      lines.push("These are related structural references, not a final diagnosis.");
      lines.push("");
      lines.push("Mapped with PENGO Workbench");
      lines.push("Use Check Input to inspect an AI ask, then Explore Results to map controlled gaps into related Patterns and Lenses.");
      lines.push("https://pengosystems.com/workbench/check-input/");

      return lines.join("\n");
    }

    function renderResults() {
      if (!(input instanceof HTMLTextAreaElement)) return;

      const { mapped, ignored } = parseInput(input.value);

      clearChildren(resultsList);
      clearChildren(ignoredList);
      lastCopyText = "";

      if (mapped.length > 0) {
        const aggregates = collectAggregates(mapped);

        resultsSection.hidden = false;
        noResultsSection.hidden = true;

        const gapsSection = document.createElement("section");
        gapsSection.className = "wb-reading-section";
        appendTextElement(gapsSection, "h2", "Controlled Gaps Mapped");

        const gapsList = document.createElement("ul");
        for (const result of mapped) {
          appendTextElement(gapsList, "li", result.detectedGap);
        }
        gapsSection.appendChild(gapsList);
        resultsList.appendChild(gapsSection);

        const patternsSection = document.createElement("section");
        patternsSection.className = "wb-section";
        appendTextElement(patternsSection, "h2", "Related Patterns");

        if (aggregates.patterns.length > 0) {
          const patternList = document.createElement("div");
          patternList.className = "wb-row-list";
          aggregates.patterns.forEach((pattern) =>
            appendRow(patternList, pattern, pattern.surfacedBy)
          );
          patternsSection.appendChild(patternList);
        } else {
          appendTextElement(patternsSection, "p", "No related Patterns surfaced.");
        }

        resultsList.appendChild(patternsSection);

        const lensSection = document.createElement("section");
        lensSection.className = "wb-section";
        appendTextElement(lensSection, "h2", "Useful Lenses");

        if (aggregates.lenses.length > 0) {
          const lensList = document.createElement("div");
          lensList.className = "wb-row-list";
          aggregates.lenses.forEach((lens) =>
            appendRow(lensList, lens, lens.surfacedBy)
          );
          lensSection.appendChild(lensList);
        } else {
          appendTextElement(lensSection, "p", "No useful Lenses derived.");
        }

        resultsList.appendChild(lensSection);

        lastCopyText = buildCopyText(mapped);
        copyButton.hidden = false;
      } else {
        resultsSection.hidden = true;
        noResultsSection.hidden = false;
        copyButton.hidden = true;
      }

      if (ignored.length > 0) {
        ignoredSection.hidden = false;
        ignoredSummary.textContent = `${ignored.length.toLocaleString()} pasted line${ignored.length === 1 ? "" : "s"} ignored because they did not match controlled Check Input gap terms.`;

        for (const line of ignored.slice(0, 5)) {
          appendTextElement(ignoredList, "li", line);
        }

        if (ignored.length > 5) {
          appendTextElement(ignoredList, "li", "Additional ignored lines hidden.");
        }
      } else {
        ignoredSection.hidden = true;
        ignoredSummary.textContent = "";
      }
    }

    input?.addEventListener("input", updateInputState);
    mapButton?.addEventListener("click", renderResults);

    copyButton?.addEventListener("click", async () => {
      if (!lastCopyText) return;

      try {
        await navigator.clipboard.writeText(lastCopyText);
        copyButton.textContent = "Copied";
        window.setTimeout(() => {
          copyButton.textContent = "Copy Workbench Results";
        }, 1600);
      } catch {
        copyButton.textContent = "Copy failed";
        window.setTimeout(() => {
          copyButton.textContent = "Copy Workbench Results";
        }, 1600);
      }
    });

    updateInputState();
  </script>
</WorkbenchLayout>
