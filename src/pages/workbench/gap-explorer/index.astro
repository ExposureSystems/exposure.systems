---
import checkInputIndex from "../../../content/_meta/check-input-index.json";

const results = checkInputIndex.results;

const acceptedExamples = results.map((result) => result.detected_gap);

const ignoredExamples = [
  "the model might hallucinate",
  "needs more context",
  "could be better",
  "bad prompt",
  "unclear business logic",
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Gap Explorer | Workbench</title>
    <meta
      name="description"
      content="Explore controlled Check Input gap terms through related Patterns and useful Lenses."
    />
  </head>
  <body>
    <main>
      <p>
        <a href="/workbench/">Workbench</a>
        {" / "}
        <a href="/workbench/check-input/">Check Input</a>
      </p>

      <h1>Gap Explorer</h1>

      <p>
        Gap Explorer is the second step after Check Input. It takes controlled
        Detected Gap terms and uses them to surface related Patterns and useful
        Lenses.
      </p>

      <p>
        {checkInputIndex.note}
      </p>

      <section aria-labelledby="flow">
        <h2 id="flow">Flow</h2>

        <ol>
          <li>Detected Gaps</li>
          <li>Check Input Matrix</li>
          <li>Related Pattern codes</li>
          <li>Pattern pages</li>
          <li>Pattern -&gt; Lens Matrix</li>
          <li>Useful Lenses</li>
        </ol>

        <p>
          These are related structural references, not a final diagnosis.
        </p>
      </section>

      <section aria-labelledby="not-issues">
        <h2 id="not-issues">Important Boundary</h2>

        <p>
          Gap Explorer does not route Detected Gaps to Issues. Issues are public
          intake and search surfaces. Gap Explorer routes controlled gap terms to
          Patterns, then derives useful Lenses through the Pattern -&gt; Lens matrix.
        </p>
      </section>

      <section aria-labelledby="future-input">
        <h2 id="future-input">Future Input</h2>

        <p>
          This page will later accept either a full Check Input output or only a
          Detected Gaps list.
        </p>

        <textarea rows="10" cols="80" placeholder={`Detected Gaps
- missing actor
- unclear scope
- unstated constraint`}></textarea>

        <p>
          Parser behavior is not active yet. The derived references below are generated
          from the current Check Input index.
        </p>
      </section>

      <section aria-labelledby="accepted">
        <h2 id="accepted">Accepted Gap Terms</h2>

        <p>
          Every accepted line must match: <code>[gap type] [element]</code>.
        </p>

        <ul>
          {acceptedExamples.map((example) => (
            <li><code>{example}</code></li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="exploration-results">
        <h2 id="exploration-results">Current Exploration Results</h2>

        {results.map((result) => (
          <article>
            <h3>{result.detected_gap}</h3>

            <p>{result.caveat}</p>

            <section aria-labelledby={`${result.detected_gap}-patterns`}>
              <h4 id={`${result.detected_gap}-patterns`}>Related Patterns</h4>

              <h5>Primary</h5>
              {result.patterns.primary.length > 0 ? (
                <ul>
                  {result.patterns.primary.map((pattern) => (
                    <li>
                      <a href={pattern.url}>
                        {pattern.code} — {pattern.title}
                      </a>
                      <p>{pattern.summary}</p>
                    </li>
                  ))}
                </ul>
              ) : (
                <p>No primary Patterns.</p>
              )}

              <h5>Secondary</h5>
              {result.patterns.secondary.length > 0 ? (
                <ul>
                  {result.patterns.secondary.map((pattern) => (
                    <li>
                      <a href={pattern.url}>
                        {pattern.code} — {pattern.title}
                      </a>
                      <p>{pattern.summary}</p>
                    </li>
                  ))}
                </ul>
              ) : (
                <p>No secondary Patterns.</p>
              )}
            </section>

            <section aria-labelledby={`${result.detected_gap}-lenses`}>
              <h4 id={`${result.detected_gap}-lenses`}>Useful Lenses</h4>

              {result.useful_lenses.length > 0 ? (
                <ul>
                  {result.useful_lenses.map((lens) => (
                    <li>
                      <a href={lens.url}>
                        {lens.code} — {lens.title}
                      </a>
                      <p>{lens.summary}</p>
                    </li>
                  ))}
                </ul>
              ) : (
                <p>No useful Lenses derived.</p>
              )}
            </section>
          </article>
        ))}
      </section>

      <section aria-labelledby="ignored">
        <h2 id="ignored">Ignored Examples</h2>

        <p>
          Freeform labels do not drive exploration.
        </p>

        <ul>
          {ignoredExamples.map((example) => (
            <li><code>{example}</code></li>
          ))}
        </ul>
      </section>
    </main>
  </body>
</html>