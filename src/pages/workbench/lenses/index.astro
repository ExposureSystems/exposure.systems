---
import WorkbenchLayout from "../../../layouts/WorkbenchLayout.astro";
import ontologyIndex from "../../../content/_meta/ontology-index.json";

const lenses = ontologyIndex.lenses;
---

<WorkbenchLayout
  title="Lenses | PENGO Workbench"
  description="Diagnostic Lenses in the Workbench ontology."
  url="https://pengosystems.com/workbench/lenses/"
  active="lenses"
  breadcrumb="Lenses"
>
  <article class="wb-content wb-template">
    <p class="wb-type-label">Diagnostic Lenses</p>
    <h1>Lenses</h1>
    <p class="wb-lede">
      Diagnostic views derived from structural Patterns through the Pattern-to-Lens Matrix.
    </p>

    <section class="wb-section" aria-label="Lenses">
      <div class="wb-row-list">
        {lenses.map((lens) => (
          <a class="wb-row" href={lens.url}>
            <p class="wb-row-meta" translate="no" class="notranslate" lang="en">
              {lens.code}
            </p>
            <h2>
              <span translate="no" class="notranslate" lang="en">{lens.title}</span>
            </h2>
            <p>{lens.summary}</p>
          </a>
        ))}
      </div>
    </section>
  </article>
</WorkbenchLayout>
