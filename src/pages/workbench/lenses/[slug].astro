---
import WorkbenchLayout from "../../../layouts/WorkbenchLayout.astro";
import ontologyIndex from "../../../content/_meta/ontology-index.json";

export function getStaticPaths() {
  return ontologyIndex.lenses.map((lens) => ({
    params: { slug: lens.slug },
    props: { lens },
  }));
}

const { lens } = Astro.props;

const primaryPatterns = lens.patterns.primary
  .map((slug) => ontologyIndex.patterns.find((pattern) => pattern.slug === slug))
  .filter(Boolean);

const secondaryPatterns = lens.patterns.secondary
  .map((slug) => ontologyIndex.patterns.find((pattern) => pattern.slug === slug))
  .filter(Boolean);

const relatedIssues = lens.issues
  .map((slug) => ontologyIndex.issues.find((issue) => issue.slug === slug))
  .filter(Boolean);
---

<WorkbenchLayout
  title={`${lens.code} - ${lens.title} | PENGO Workbench`}
  description={lens.summary}
  url={`https://pengosystems.com${lens.url}`}
  active="lenses"
  breadcrumbs={[
    { label: "Lenses", href: "/workbench/lenses/" },
    { label: lens.title },
  ]}
>
  <article class="wb-content wb-template">
    <p class="wb-type-label" translate="no" class:list={["notranslate"]} lang="en">
      {lens.code}
    </p>

    <h1>
      <span translate="no" class="notranslate" lang="en">{lens.title}</span>
    </h1>

    <p class="wb-lede">{lens.summary}</p>

    <section class="wb-section">
      <h2>Primary Pattern Matches</h2>

      {primaryPatterns.length > 0 ? (
        <div class="wb-row-list">
          {primaryPatterns.map((pattern) => (
            <a class="wb-row" href={pattern.url}>
              <p class="wb-row-meta" translate="no" class="notranslate" lang="en">
                {pattern.code}
              </p>
              <h2>
                <span translate="no" class="notranslate" lang="en">{pattern.title}</span>
              </h2>
              <p>{pattern.summary}</p>
            </a>
          ))}
        </div>
      ) : (
        <p>No primary pattern matches.</p>
      )}
    </section>

    {secondaryPatterns.length > 0 && (
      <section class="wb-section">
        <h2>Secondary Pattern Matches</h2>

        <div class="wb-row-list">
          {secondaryPatterns.map((pattern) => (
            <a class="wb-row" href={pattern.url}>
              <p class="wb-row-meta" translate="no" class="notranslate" lang="en">
                {pattern.code}
              </p>
              <h2>
                <span translate="no" class="notranslate" lang="en">{pattern.title}</span>
              </h2>
              <p>{pattern.summary}</p>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="wb-section">
      <h2>Related Issues</h2>

      {relatedIssues.length > 0 ? (
        <div class="wb-row-list">
          {relatedIssues.map((issue) => (
            <a class="wb-row" href={issue.url}>
              <p class="wb-row-meta" translate="no" class="notranslate" lang="en">
                {issue.code}
              </p>
              <h2>{issue.title}</h2>
              <p>{issue.summary}</p>
            </a>
          ))}
        </div>
      ) : (
        <p>No related issues.</p>
      )}
    </section>
  </article>
</WorkbenchLayout>
