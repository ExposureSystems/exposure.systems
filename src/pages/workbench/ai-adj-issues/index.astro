---
import WorkbenchLayout from "../../../layouts/WorkbenchLayout.astro";
import ontologyIndex from "../../../content/_meta/ontology-index.json";

const aiAdjIssues = ontologyIndex.ai_adj_issues ?? [];
---

<WorkbenchLayout
  title="AI-Adjacent Issues | PENGO Workbench"
  description="Browse AI-adjacent issues: problems users may experience as AI failures, but which may involve tools, apps, permissions, runtime behavior, configuration, or integrations."
  url="https://pengosystems.com/workbench/ai-adj-issues/"
  active="ai-adj-issues"
  breadcrumb="AI-Adjacent Issues"
>
  <article class="wb-content wb-template">
    <p class="wb-type-label">Issue Boundary</p>
    <h1>AI-Adjacent Issues</h1>
    <p class="wb-lede">
      Problems users may experience as AI failures, but which may involve tools, apps, permissions, runtime behavior, configuration, product surfaces, or integrations.
    </p>

    <section class="wb-section" aria-label="AI-Adjacent Issues">
      {aiAdjIssues.length > 0 ? (
        <div class="wb-row-list">
          {aiAdjIssues.map((entry) => (
            <a class="wb-row" href={entry.url}>
              <p class="wb-row-meta" translate="no" class="notranslate" lang="en">
                {entry.code}
              </p>
              <h2>{entry.title}</h2>
              <p>{entry.summary}</p>
            </a>
          ))}
        </div>
      ) : (
        <p>No AI-Adjacent Issues are currently published.</p>
      )}
    </section>
  </article>
</WorkbenchLayout>
