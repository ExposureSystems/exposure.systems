---
import { getCollection } from "astro:content";
import WorkbenchLayout from "../../../layouts/WorkbenchLayout.astro";
import ontologyIndex from "../../../content/_meta/ontology-index.json";

export async function getStaticPaths() {
  const entries = await getCollection("ai-adj-issues");

  return entries.map((entry) => ({
    params: { slug: entry.data.ontology_slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const indexEntry = ontologyIndex.ai_adj_issues.find(
  (item) => item.ontology_slug === entry.data.ontology_slug
);

const relatedIssues = (indexEntry?.related_issues ?? [])
  .map((ontologySlug) =>
    ontologyIndex.issues.find((issue) => issue.ontology_slug === ontologySlug)
  )
  .filter(Boolean);
---

<WorkbenchLayout
  title={`${entry.data.title} | PENGO Workbench`}
  description={entry.data.summary}
  url={`https://pengosystems.com/workbench/ai-adj-issues/${entry.data.ontology_slug}/`}
  active="ai-adj-issues"
  breadcrumbs={[
    { label: "AI-Adjacent Issues", href: "/workbench/ai-adj-issues/" },
    { label: entry.data.title },
  ]}
>
  <article class="wb-content wb-template">
    <p class="wb-type-label">AI-Adjacent Issue</p>
    <h1>{entry.data.title}</h1>
    <p class="wb-lede">{entry.data.summary}</p>

    <section class="wb-reading-section">
      <Content />
    </section>

    <section class="wb-section">
      <h2>Related Workbench Issues</h2>

      {relatedIssues.length > 0 ? (
        <div class="wb-row-list">
          {relatedIssues.map((issue) => (
            <a class="wb-row" href={issue.url}>
              <p class="wb-row-meta" translate="no" class="notranslate" lang="en">
                {issue.code}
              </p>
              <h2>{issue.title}</h2>
              <p>{issue.summary}</p>
            </a>
          ))}
        </div>
      ) : (
        <p>No related Workbench Issues are currently mapped.</p>
      )}
    </section>

    {entry.data.search_intents.length > 0 && (
      <section class="wb-section">
        <h2>Common Ways People Describe This</h2>

        <ul>
          {entry.data.search_intents.map((phrase) => (
            <li>{phrase}</li>
          ))}
        </ul>
      </section>
    )}
  </article>
</WorkbenchLayout>
