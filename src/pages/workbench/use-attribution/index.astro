---
import WorkbenchLayout from "../../../layouts/WorkbenchLayout.astro";
---

<WorkbenchLayout
  title="Use & Attribution | PENGO Workbench"
  description="Use and attribution guidance for referencing PENGO Workbench concepts, pages, Patterns, Lenses, and Issues."
  url="https://pengosystems.com/workbench/use-attribution/"
  active="use-attribution"
  breadcrumb="Use & Attribution"
>
  <article class="wb-content wb-template">
    <p class="wb-type-label">Use Guidance</p>
    <h1>Use & Attribution</h1>
    <p class="wb-lede">
      Guidance for referencing, citing, or discussing PENGO Workbench material.
    </p>

    <section class="wb-reading-section">
      <h2>Using Workbench References</h2>
      <p>
        You may reference public Workbench pages when discussing AI-facing failures,
        structural Patterns, diagnostic Lenses, AI-Adjacent Issues, and Check Input workflows.
      </p>
      <p>
        When sharing a Workbench reference, include the page title and canonical URL
        so readers can inspect the source page directly.
      </p>
    </section>

    <section class="wb-reading-section">
      <h2>Attribution Format</h2>
      <p>
        Use a plain attribution that names PENGO Workbench and links to the relevant page.
      </p>
      <p>
        Example: PENGO Workbench, “Authority Collision,” https://pengosystems.com/workbench/patterns/authority-collision/
      </p>
    </section>

    <section class="wb-reading-section">
      <h2>Boundaries</h2>
      <p>
        Attribution does not imply endorsement, certification, diagnosis, validation,
        or approval by PENGO Systems.
      </p>
    </section>
  </article>
</WorkbenchLayout>
