---
import WorkbenchLayout from "../../../layouts/WorkbenchLayout.astro";
---

<WorkbenchLayout
  title="Use & Attribution | PENGO Workbench"
  description="Use and attribution guidance for referencing PENGO Workbench pages, Issues, Patterns, Lenses, and Check Input workflows."
  url="https://pengosystems.com/workbench/use-attribution/"
  active="use-attribution"
  breadcrumb="Use & Attribution"
>
  <article class="wb-content wb-template">
    <p class="wb-type-label">Use Guidance</p>
    <h1>Use & Attribution</h1>
    <p class="wb-lede">
      How to reference PENGO Workbench pages, terms, Issues, Patterns, Lenses, and Check Input workflows.
    </p>

    <section class="wb-reading-section">
      <h2>Using Workbench Material</h2>
      <p>
        Public Workbench pages may be referenced when discussing AI-facing failures,
        prompt problems, workflow breakdowns, structural Patterns, diagnostic Lenses,
        AI-Adjacent Issues, and Check Input workflows.
      </p>
      <p>
        Reference the specific page you used so readers can inspect the source directly.
      </p>
    </section>

    <section class="wb-reading-section">
      <h2>Simple Attribution</h2>
      <p>
        Use the page title, PENGO Workbench, and the canonical page URL.
      </p>

      <pre><code>PENGO Workbench, “Authority Collision”
https://pengosystems.com/workbench/patterns/authority-collision/</code></pre>
    </section>

    <section class="wb-reading-section">
      <h2>Good Uses</h2>
      <ul>
        <li>Linking to a Workbench Issue when describing a visible AI failure surface.</li>
        <li>Linking to a Pattern or Lens when explaining a structural interpretation.</li>
        <li>Referencing Check Input as an input-inspection workflow.</li>
        <li>Using Workbench terms in notes, articles, training material, or internal review.</li>
      </ul>
    </section>

    <section class="wb-reading-section">
      <h2>Do Not Imply</h2>
      <ul>
        <li>Do not imply PENGO Systems reviewed or endorsed your work.</li>
        <li>Do not present a Workbench reference as proof of cause.</li>
        <li>Do not present a mapped Pattern or Lens as a final diagnosis.</li>
        <li>Do not rename Workbench terms in a way that makes them appear official.</li>
      </ul>
    </section>
  </article>
</WorkbenchLayout>
