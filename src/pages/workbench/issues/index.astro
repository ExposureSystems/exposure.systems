---
import WorkbenchLayout from "../../../layouts/WorkbenchLayout.astro";
import ontologyIndex from "../../../content/_meta/ontology-index.json";

const categories = ontologyIndex.categories;
---

<WorkbenchLayout
  title="Issues | PENGO Workbench"
  description="Browse common AI-era failure modes by category."
  url="https://pengosystems.com/workbench/issues/"
  active="issues"
  breadcrumb="Issues"
>
  <article class="wb-content wb-template wb-issue-browse">
    <div class="wb-page-action">
      <span aria-current="page">Browse by Category</span>
      <a href="/workbench/issues/all/">See All Issues</a>
    </div>

    <p class="wb-type-label">Issue Browsing</p>
    <h1>Issues</h1>
    <p class="wb-lede">
      Browse common AI-era failure modes by category.
    </p>

    <section class="wb-section" aria-label="Issue categories">
      <div class="wb-row-list">
        {categories.map((category) => (
          <section class="wb-row">
            <h2>
              <a href={category.url}>{category.title}</a>
            </h2>
            <p>{category.summary}</p>
          </section>
        ))}
      </div>
    </section>
  </article>
</WorkbenchLayout>
