---
import WorkbenchLayout from "../../../../layouts/WorkbenchLayout.astro";
import IssuePagination from "../../../../components/workbench/IssuePagination.astro";
import ontologyIndex from "../../../../content/_meta/ontology-index.json";

const issues = ontologyIndex.issues;
const pageSize = 24;
const totalPages = Math.ceil(issues.length / pageSize);

export function getStaticPaths() {
  const pageSizeForPaths = 24;
  const totalPagesForPaths = Math.ceil(ontologyIndex.issues.length / pageSizeForPaths);

  return Array.from({ length: Math.max(totalPagesForPaths - 1, 0) }, (_, index) => {
    const page = index + 2;

    return {
      params: { page: String(page) },
      props: { currentPage: page },
    };
  });
}

const { currentPage } = Astro.props;
const pageIssues = issues.slice((currentPage - 1) * pageSize, currentPage * pageSize);
---

<WorkbenchLayout
  title={`All Issues, Page ${currentPage} | PENGO Workbench`}
  description="A flat reference list of sampled Workbench issues."
  url={`https://pengosystems.com/workbench/issues/all/${currentPage}/`}
  active="issues"
  breadcrumb="All Issues"
>
  <article class="wb-content wb-template wb-issue-browse">
    <div class="wb-page-action">
      <a href="/workbench/issues/">Browse by Category</a>
      <span aria-current="page">See All Issues</span>
    </div>

    <p class="wb-type-label">Issue Index</p>
    <h1>All Issues</h1>
    <p class="wb-lede">
      Complete comprehensive list of all issues.
    </p>

    <IssuePagination
      currentPage={currentPage}
      totalPages={totalPages}
      totalItems={issues.length}
      pageSize={pageSize}
    />

    <section class="wb-section" aria-label={`All issues, page ${currentPage}`}>
      <div class="wb-row-list">
        {pageIssues.map((issue) => (
          <a class="wb-row" href={issue.url}>
            <p class="wb-row-meta">{issue.category_title}</p>
            <h2>{issue.title}</h2>
            <p>{issue.summary}</p>
          </a>
        ))}
      </div>
    </section>

    <IssuePagination
      currentPage={currentPage}
      totalPages={totalPages}
      totalItems={issues.length}
      pageSize={pageSize}
    />
  </article>
</WorkbenchLayout>
