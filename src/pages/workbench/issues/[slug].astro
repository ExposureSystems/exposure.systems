---
import { getCollection } from "astro:content";
import WorkbenchLayout from "../../../layouts/WorkbenchLayout.astro";
import ontologyIndex from "../../../content/_meta/ontology-index.json";

export async function getStaticPaths() {
  const entries = await getCollection("issues");

  return entries.map((entry) => {
    const issue = ontologyIndex.issues.find(
      (item) => item.ontology_slug === entry.data.ontology_slug
    );

    return {
      params: { slug: entry.data.ontology_slug },
      props: { entry, issue },
    };
  });
}

const { entry, issue } = Astro.props;
const { Content } = await entry.render();

const category = ontologyIndex.categories.find((item) => item.slug === issue.category);

const primaryPattern = ontologyIndex.patterns.find(
  (pattern) => pattern.slug === issue.primary_pattern
);

const declaredPatterns = issue.patterns
  .map((slug) => ontologyIndex.patterns.find((pattern) => pattern.slug === slug))
  .filter(Boolean);

const primaryLenses = issue.derived_lenses.primary
  .map((slug) => ontologyIndex.lenses.find((lens) => lens.slug === slug))
  .filter(Boolean);

const secondaryLenses = issue.derived_lenses.secondary
  .map((slug) => ontologyIndex.lenses.find((lens) => lens.slug === slug))
  .filter(Boolean);

const relatedAiAdjIssues = (issue.related_ai_adj_issues ?? [])
  .map((slug) => ontologyIndex.ai_adj_issues.find((entry) => entry.slug === slug))
  .filter(Boolean);
---

<WorkbenchLayout
  title={`${issue.title} | PENGO Workbench`}
  description={issue.summary}
  url={`https://pengosystems.com${issue.url}`}
  active="issues"
  breadcrumbs={[
    { label: "Issues", href: "/workbench/issues/" },
    { label: issue.title },
  ]}
>
  <article class="wb-content wb-template">
    <p class="wb-type-label">Issue</p>
    <h1>{issue.title}</h1>
    <p class="wb-lede">{issue.summary}</p>

    <section class="wb-reading-section">
      <Content />
    </section>

    <section class="wb-section">
      <h2>Category</h2>
      {category ? (
        <p>
          <a href={category.url}>{category.title}</a>
        </p>
      ) : (
        <p>{issue.category}</p>
      )}
    </section>

    <section class="wb-section">
      <h2>Primary Pattern</h2>
      {primaryPattern ? (
        <p>
          <a href={primaryPattern.url} translate="no" class="notranslate" lang="en">
            {primaryPattern.code} — {primaryPattern.title}
          </a>
        </p>
      ) : (
        <p>{issue.primary_pattern}</p>
      )}
    </section>

    {declaredPatterns.length > 0 && (
      <section class="wb-section">
        <h2>Declared Patterns</h2>
        <div class="wb-row-list">
          {declaredPatterns.map((pattern) => (
            <a class="wb-row" href={pattern.url}>
              <p class="wb-row-meta" translate="no" class="notranslate" lang="en">
                {pattern.code}
              </p>
              <h2>
                <span translate="no" class="notranslate" lang="en">{pattern.title}</span>
              </h2>
              <p>{pattern.summary}</p>
            </a>
          ))}
        </div>
      </section>
    )}

    {primaryLenses.length > 0 && (
      <section class="wb-section">
        <h2>Derived Primary Lenses</h2>
        <div class="wb-row-list">
          {primaryLenses.map((lens) => (
            <a class="wb-row" href={lens.url}>
              <p class="wb-row-meta" translate="no" class="notranslate" lang="en">
                {lens.code}
              </p>
              <h2>
                <span translate="no" class="notranslate" lang="en">{lens.title}</span>
              </h2>
              <p>{lens.summary}</p>
            </a>
          ))}
        </div>
      </section>
    )}

    {secondaryLenses.length > 0 && (
      <section class="wb-section">
        <h2>Derived Secondary Lenses</h2>
        <div class="wb-row-list">
          {secondaryLenses.map((lens) => (
            <a class="wb-row" href={lens.url}>
              <p class="wb-row-meta" translate="no" class="notranslate" lang="en">
                {lens.code}
              </p>
              <h2>
                <span translate="no" class="notranslate" lang="en">{lens.title}</span>
              </h2>
              <p>{lens.summary}</p>
            </a>
          ))}
        </div>
      </section>
    )}

    {relatedAiAdjIssues.length > 0 && (
      <section class="wb-section">
        <h2>Related AI-Adjacent Issues</h2>
        <div class="wb-row-list">
          {relatedAiAdjIssues.map((entry) => (
            <a class="wb-row" href={entry.url}>
              <p class="wb-row-meta" translate="no" class="notranslate" lang="en">
                {entry.code}
              </p>
              <h2>{entry.title}</h2>
              <p>{entry.summary}</p>
            </a>
          ))}
        </div>
      </section>
    )}

    {issue.search_intents.length > 0 && (
      <section class="wb-section">
        <h2>Search Intents</h2>
        <ul>
          {issue.search_intents.map((intent) => (
            <li>{intent}</li>
          ))}
        </ul>
      </section>
    )}
  </article>
</WorkbenchLayout>
