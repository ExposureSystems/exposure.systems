---
import WorkbenchLayout from "../../../layouts/WorkbenchLayout.astro";
import searchIndex from "../../../content/_meta/search-index.json";
import ontologyIndex from "../../../content/_meta/ontology-index.json";

const issues = ontologyIndex.issues;
const aiAdjIssues = ontologyIndex.ai_adj_issues ?? [];
const patterns = ontologyIndex.patterns;
const lenses = ontologyIndex.lenses;

const searchEntries = [
  ...issues.map((issue) => ({
    type: "Issue",
    title: issue.title,
    summary: issue.summary,
    url: issue.url,
    code: issue.code,
    meta: issue.category_title,
    searchable: [
      issue.code,
      issue.title,
      issue.summary,
      issue.category_title,
      issue.primary_pattern,
      ...(issue.patterns ?? []),
      ...((issue.lenses?.primary ?? [])),
      ...((issue.lenses?.secondary ?? [])),
    ].filter(Boolean).join(" "),
  })),

  ...aiAdjIssues.map((issue) => ({
    type: "AI-Adjacent Issue",
    title: issue.title,
    summary: issue.summary,
    url: issue.url,
    code: issue.code,
    meta: `${issue.related_issues?.length ?? 0} related Workbench Issues`,
    searchable: [
      issue.code,
      issue.title,
      issue.summary,
      ...(issue.search_intents ?? []),
      ...(issue.related_issues ?? []),
    ].filter(Boolean).join(" "),
  })),

  ...patterns.map((pattern) => ({
    type: "Pattern",
    title: pattern.title,
    summary: pattern.summary,
    url: pattern.url,
    code: pattern.code,
    meta: `${pattern.issues?.primary?.length ?? 0} primary issue matches`,
    searchable: [
      pattern.code,
      pattern.title,
      pattern.summary,
      pattern.slug,
      ...(pattern.issues?.primary ?? []),
      ...(pattern.issues?.supporting ?? []),
      ...(pattern.lenses?.primary ?? []),
      ...(pattern.lenses?.secondary ?? []),
    ].filter(Boolean).join(" "),
  })),

  ...lenses.map((lens) => ({
    type: "Lens",
    title: lens.title,
    summary: lens.summary,
    url: lens.url,
    code: lens.code,
    meta: `${lens.issues?.length ?? 0} related issues`,
    searchable: [
      lens.code,
      lens.title,
      lens.summary,
      lens.slug,
      ...(lens.issues ?? []),
      ...(lens.patterns?.primary ?? []),
      ...(lens.patterns?.secondary ?? []),
    ].filter(Boolean).join(" "),
  })),
];

const browseLinks = [
  { label: "Issues", href: "/workbench/issues/", count: issues.length },
  { label: "AI-Adjacent Issues", href: "/workbench/ai-adj-issues/", count: aiAdjIssues.length },
  { label: "Patterns", href: "/workbench/patterns/", count: patterns.length },
  { label: "Lenses", href: "/workbench/lenses/", count: lenses.length },
];
---

<WorkbenchLayout
  title="Search | PENGO Workbench"
  description="Search PENGO Workbench Issues, AI-Adjacent Issues, Patterns, Lenses, names, and codes."
  url="https://pengosystems.com/workbench/search/"
  active="search"
  breadcrumb="Search"
>
  <article class="wb-content wb-template">
    <p class="wb-type-label">Workbench Search</p>
    <h1>Search</h1>
    <p class="wb-lede">
      Find the structure behind the visible failure surface.
    </p>

    <section class="wb-section wb-search-entry" aria-label="Search Workbench">
      <div class="wb-search-bar">
        <input
          id="workbench-search-input"
          type="search"
          autocomplete="off"
          spellcheck="false"
          data-workbench-search-input
          placeholder="Search Workbench..."
        />
        <button type="button" data-clear-search hidden>
          Clear results
        </button>
      </div>
    </section>

    <section class="wb-section" data-search-results-section>
      <h2>Results</h2>
      <p data-search-status>Start typing to search Workbench references.</p>
      <div class="wb-row-list" data-search-results></div>
    </section>

    <section class="wb-section">
      <h2>Browse instead</h2>

      <div class="wb-browse-simple">
        {browseLinks.map((item) => (
          <a href={item.href}>
            <span>{item.label}</span>
            <small>{item.count}</small>
          </a>
        ))}
      </div>
    </section>

    <section class="wb-reading-section">
      <h2>How to Read This</h2>

      <p>
        Search helps surface related Workbench references. It does not validate a prompt,
        score a model, prove causality, or replace Check Input.
      </p>
    </section>
  </article>

  <script
    type="application/json"
    id="workbench-search-data"
    set:html={JSON.stringify(searchEntries)}
  ></script>

  <style>
    .wb-search-entry {
      margin-top: 1.1rem;
    }

    .wb-search-bar {
      display: flex;
      align-items: center;
      gap: 0.65rem;
    }

    .wb-search-bar input {
      display: block;
      width: 100%;
      border: 1px solid var(--color-border);
      border-radius: 14px;
      background: var(--color-surface);
      color: var(--color-text);
      padding: 0.9rem 1rem;
      font: inherit;
      font-size: 1rem;
      line-height: 1.2;
    }

    .wb-search-bar input:focus {
      border-color: var(--color-accent);
      outline: 2px solid var(--color-accent);
      outline-offset: 2px;
    }

    .wb-search-bar button {
      appearance: none;
      flex: 0 0 auto;
      border: 0;
      background: transparent;
      color: var(--color-accent);
      padding: 0.4rem 0;
      font: inherit;
      font-size: 0.78rem;
      line-height: 1;
      font-weight: 850;
      cursor: pointer;
    }

    .wb-search-bar button:hover {
      text-decoration: underline;
    }

    .wb-browse-simple {
      display: grid;
      gap: 0.4rem;
      margin-top: 0.9rem;
    }

    .wb-browse-simple a {
      display: flex;
      align-items: baseline;
      justify-content: flex-start;
      gap: 0.55rem;
      border-bottom: 1px solid var(--color-border);
      padding: 0.65rem 0;
      color: var(--color-text);
      text-decoration: none;
    }

    .wb-browse-simple a:hover span {
      color: var(--color-accent);
    }

    .wb-browse-simple small {
      color: var(--color-muted);
      font-size: 0.78rem;
      font-weight: 800;
    }

    .wb-search-result-url {
      margin-top: 0.18rem !important;
      color: var(--color-faint) !important;
      font-size: 0.72rem !important;
      line-height: 1.35 !important;
      word-break: break-all;
    }
  </style>

  <script>
    const dataElement = document.getElementById("workbench-search-data");
    const input = document.querySelector("[data-workbench-search-input]");
    const clearButton = document.querySelector("[data-clear-search]");
    const resultsList = document.querySelector("[data-search-results]");
    const status = document.querySelector("[data-search-status]");

    const entries = JSON.parse(dataElement?.textContent || "[]").map((entry) => ({
      ...entry,
      haystack: [
        entry.type,
        entry.code,
        entry.title,
        entry.summary,
        entry.meta,
        entry.searchable,
      ].filter(Boolean).join(" ").toLowerCase(),
    }));

    function clearChildren(element) {
      if (!element) return;
      while (element.firstChild) {
        element.removeChild(element.firstChild);
      }
    }

    function appendTextElement(parent, tagName, text, className) {
      const element = document.createElement(tagName);
      element.textContent = text;
      if (className) {
        element.className = className;
      }
      parent.appendChild(element);
      return element;
    }

    function renderRow(entry) {
      const row = document.createElement("a");
      row.className = "wb-row";
      row.href = entry.url;

      const title = document.createElement("h2");

      if (entry.type === "Pattern" || entry.type === "Lens") {
        const span = appendTextElement(title, "span", entry.title, "notranslate");
        span.setAttribute("translate", "no");
        span.setAttribute("lang", "en");
      } else {
        title.textContent = entry.title;
      }

      row.appendChild(title);

      appendTextElement(row, "p", entry.summary || "");
      appendTextElement(row, "p", entry.url.replace("https://pengosystems.com", ""), "wb-search-result-url");

      return row;
    }

    function scoreEntry(entry, query, terms) {
      let score = 0;
      const title = String(entry.title || "").toLowerCase();
      const code = String(entry.code || "").toLowerCase();

      if (code === query) score += 100;
      if (code.includes(query)) score += 60;
      if (title.includes(query)) score += 40;

      for (const term of terms) {
        if (code.includes(term)) score += 20;
        if (title.includes(term)) score += 12;
        if (entry.haystack.includes(term)) score += 4;
      }

      return score;
    }

    function updateSearch() {
      if (!(input instanceof HTMLInputElement)) return;

      const query = input.value.trim().toLowerCase();
      clearChildren(resultsList);

      const url = new URL(window.location.href);

      if (query) {
        url.searchParams.set("q", query);
      } else {
        url.searchParams.delete("q");
      }

      window.history.replaceState({}, "", url);

      if (clearButton instanceof HTMLButtonElement) {
        clearButton.hidden = !query;
      }

      if (!query) {
        status.textContent = "Start typing to search Workbench references.";
        return;
      }

      const terms = query.split(/\s+/).filter(Boolean);

      const matches = entries
        .map((entry) => ({ entry, score: scoreEntry(entry, query, terms) }))
        .filter(({ entry }) => terms.every((term) => entry.haystack.includes(term)))
        .sort((a, b) => b.score - a.score || a.entry.title.localeCompare(b.entry.title))
        .slice(0, 40)
        .map(({ entry }) => entry);

      if (matches.length === 0) {
        status.textContent = "No matching Workbench references found. Try a code, issue phrase, Pattern name, Lens name, or category.";
        return;
      }

      status.textContent = `Showing ${matches.length.toLocaleString()} matching Workbench reference${matches.length === 1 ? "" : "s"}.`;

      for (const match of matches) {
        resultsList.appendChild(renderRow(match));
      }
    }

    const params = new URLSearchParams(window.location.search);
    const initialQuery = params.get("q");

    if (input instanceof HTMLInputElement && initialQuery) {
      input.value = initialQuery;
    }

    input?.addEventListener("input", updateSearch);

    clearButton?.addEventListener("click", () => {
      if (!(input instanceof HTMLInputElement)) return;

      input.value = "";
      input.focus();
      updateSearch();
    });

    updateSearch();
  </script>
</WorkbenchLayout>
