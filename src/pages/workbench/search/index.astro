---
import WorkbenchLayout from "../../../layouts/WorkbenchLayout.astro";
import searchIndex from "../../../content/_meta/search-index.json";

const items = searchIndex.items;
const issueItems = items.filter((item) => item.type === "issue");
const aiAdjIssueItems = items.filter((item) => item.type === "ai_adj_issue");

const categories = searchIndex.facets.categories;
const patterns = searchIndex.facets.patterns;
const lenses = searchIndex.facets.lenses;
---

<WorkbenchLayout
  title="Search | PENGO Workbench"
  description="Search PENGO Workbench Issues, AI-Adjacent Issues, Patterns, Lenses, Categories, gap terms, names, and codes."
  url="https://pengosystems.com/workbench/search/"
  active="search"
  breadcrumb="Search"
>
  <article class="wb-content wb-template">
    <p class="wb-type-label">Workbench Search</p>
    <h1>Search</h1>
    <p class="wb-lede">
      Find the structure behind the visible failure surface.
    </p>

    <section class="wb-reading-section">
      <h2>What This Page Contains</h2>
      <p>{searchIndex.note}</p>
      <p>
        This is a generated reference gateway for the current public Workbench index.
        Interactive search and filtering can be added later.
      </p>
    </section>

    <section class="wb-section">
      <h2>Reference Areas</h2>

      <div class="wb-row-list">
        <a class="wb-row" href="/workbench/issues/">
          <p class="wb-row-meta">{issueItems.length} indexed</p>
          <h2>Issues</h2>
          <p>Visible failure surfaces users may experience or search for.</p>
        </a>

        <a class="wb-row" href="/workbench/ai-adj-issues/">
          <p class="wb-row-meta">{aiAdjIssueItems.length} indexed</p>
          <h2>AI-Adjacent Issues</h2>
          <p>Problems users may experience as AI failures, but which may involve tools, apps, permissions, runtime behavior, configuration, or integrations.</p>
        </a>

        <a class="wb-row" href="/workbench/patterns/">
          <p class="wb-row-meta">{patterns.length} indexed</p>
          <h2>Patterns</h2>
          <p>Canonical structural forms declared by Workbench Issues and connected to analytical Lenses.</p>
        </a>

        <a class="wb-row" href="/workbench/lenses/">
          <p class="wb-row-meta">{lenses.length} indexed</p>
          <h2>Lenses</h2>
          <p>Diagnostic views derived from structural Patterns through the Pattern-to-Lens Matrix.</p>
        </a>

        <a class="wb-row" href="/workbench/check-input/">
          <p class="wb-row-meta">Protocol</p>
          <h2>Check Input</h2>
          <p>Inspect an AI ask, produce controlled gap terms, and map results into Workbench references.</p>
        </a>
      </div>
    </section>

    <section class="wb-section">
      <h2>Index Counts</h2>

      <ul>
        <li>{issueItems.length} Issues</li>
        <li>{aiAdjIssueItems.length} AI-Adjacent Issues</li>
        <li>{categories.length} Categories</li>
        <li>{patterns.length} Patterns</li>
        <li>{lenses.length} Lenses</li>
      </ul>
    </section>

    <section class="wb-section">
      <h2>Derived Facets</h2>

      <p>
        Facets help you explore the structural language around each visible Issue surface.
        They do not prove cause or diagnose the model.
      </p>

      <section class="wb-reading-section">
        <h2>Categories</h2>
        <ul>
          {categories.map((category) => (
            <li>{category.title} — {category.count}</li>
          ))}
        </ul>
      </section>

      <section class="wb-reading-section">
        <h2>Patterns</h2>
        <ul>
          {patterns.map((pattern) => (
            <li>
              <span translate="no" class="notranslate" lang="en">
                {pattern.code} - {pattern.title}
              </span>
              {" - "}
              {pattern.count}
            </li>
          ))}
        </ul>
      </section>

      <section class="wb-reading-section">
        <h2>Lenses</h2>
        <ul>
          {lenses.map((lens) => (
            <li>
              <span translate="no" class="notranslate" lang="en">
                {lens.code} - {lens.title}
              </span>
              {" - "}
              {lens.count}
            </li>
          ))}
        </ul>
      </section>
    </section>

    <section class="wb-reading-section">
      <h2>How to Read This</h2>

      <p>
        Search helps surface related Workbench references. It does not validate a prompt,
        score a model, prove causality, or replace Check Input.
      </p>
    </section>
  </article>
</WorkbenchLayout>
