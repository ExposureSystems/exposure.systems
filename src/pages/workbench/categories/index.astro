---
import WorkbenchLayout from "../../../layouts/WorkbenchLayout.astro";
import ontologyIndex from "../../../content/_meta/ontology-index.json";

const categories = ontologyIndex.categories;
---

<WorkbenchLayout
  title="Categories | PENGO Workbench"
  description="Browse Workbench issue categories."
  url="https://pengosystems.com/workbench/categories/"
  active="issues"
  breadcrumbs={[
    { label: "Issues", href: "/workbench/issues/" },
    { label: "Categories" },
  ]}
>
  <article class="wb-content wb-template">
    <p class="wb-type-label">Category Index</p>
    <h1>Categories</h1>
    <p class="wb-lede">
      Browse Workbench issue categories.
    </p>

    <section class="wb-section" aria-label="Categories">
      <div class="wb-row-list">
        {categories.map((category) => (
          <section class="wb-row">
            <h2>
              <a href={category.url}>{category.title}</a>
            </h2>
            <p>{category.summary}</p>
          </section>
        ))}
      </div>
    </section>
  </article>
</WorkbenchLayout>
