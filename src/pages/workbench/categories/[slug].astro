---
import ontologyIndex from "../../../content/_meta/ontology-index.json";
import changelog from "../../../ontology/changelog.public.json";
import release from "../../../ontology/ontology-release.json";
import {
  getChangeTypeLabel,
  getObjectHistory,
  getReceiptImpactLabel,
  getVersionLabel,
} from "../../../lib/ontology/page-metadata";

export function getStaticPaths() {
  return ontologyIndex.categories.map((category) => ({
    params: { slug: category.slug },
    props: { category },
  }));
}

const { category } = Astro.props;

const categoryIssues = category.issues
  .map((slug) => ontologyIndex.issues.find((issue) => issue.slug === slug))
  .filter(Boolean);

const history = getObjectHistory(changelog, category);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{category.title} | Workbench Category</title>
    <meta name="description" content={category.summary} />
  </head>
  <body>
    <main>
      <p>
        <a href="/workbench/">Workbench</a>
        {" / "}
        <a href="/workbench/categories/">Categories</a>
      </p>

      <h1>{category.title}</h1>

      <p>{category.summary}</p>

      <section aria-labelledby="issues">
        <h2 id="issues">Issues</h2>

        {categoryIssues.length > 0 ? (
          <ul>
            {categoryIssues.map((issue) => (
              <li>
                <a href={issue.url}>{issue.title}</a>
                <p>{issue.summary}</p>
              </li>
            ))}
          </ul>
        ) : (
          <p>No issues in this category.</p>
        )}
      </section>

      <section aria-labelledby="ontology-metadata">
        <h2 id="ontology-metadata">Ontology Metadata</h2>

        <dl>
          <dt>Code</dt>
          <dd><code>{category.code}</code></dd>

          <dt>Version</dt>
          <dd><code>{getVersionLabel(category)}</code></dd>

          <dt>Ontology release</dt>
          <dd>{release.ontology_release}</dd>

          <dt>Updated</dt>
          <dd>{category.updated_at}</dd>
        </dl>

        <h3>History</h3>

        {history.length > 0 ? (
          <ul>
            {history.map((entry) => (
              <li>
                <p>
                  <strong>{entry.entry_version}</strong>
                  {" — "}
                  {entry.date}
                  {" — "}
                  {getChangeTypeLabel(entry.change_type)}
                </p>
                <p>{entry.public_summary}</p>
                <p>Receipt impact: {getReceiptImpactLabel(entry.receipt_impact)}</p>
              </li>
            ))}
          </ul>
        ) : (
          <p>No public history entries recorded.</p>
        )}

        <p>
          <a href="/workbench/ontology/changelog/">View full ontology changelog</a>
        </p>
      </section>
    </main>
  </body>
</html>