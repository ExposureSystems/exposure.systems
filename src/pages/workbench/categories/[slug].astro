---
import WorkbenchLayout from "../../../layouts/WorkbenchLayout.astro";
import ontologyIndex from "../../../content/_meta/ontology-index.json";

export function getStaticPaths() {
  return ontologyIndex.categories.map((category) => ({
    params: { slug: category.slug },
    props: { category },
  }));
}

const { category } = Astro.props;

const sortByCode = (a, b) => a.code.localeCompare(b.code);

const primaryIssues = (category.primary_issues ?? category.issues ?? [])
  .map((slug) => ontologyIndex.issues.find((issue) => issue.slug === slug))
  .filter(Boolean)
  .sort(sortByCode);

const secondaryIssues = (category.secondary_issues ?? [])
  .map((slug) => ontologyIndex.issues.find((issue) => issue.slug === slug))
  .filter(Boolean)
  .sort(sortByCode);

const relatedIssueDisplayLimit = 8;
const displayedSecondaryIssues = secondaryIssues.slice(0, relatedIssueDisplayLimit);
const hiddenSecondaryIssueCount = Math.max(
  secondaryIssues.length - displayedSecondaryIssues.length,
  0,
);
---

<WorkbenchLayout
  title={`${category.title} | PENGO Workbench`}
  description={category.summary}
  url={`https://pengosystems.com${category.url}`}
  active="issues"
  breadcrumbs={[
    { label: "Categories", href: "/workbench/categories/" },
    { label: category.title },
  ]}
>
  <article class="wb-content wb-template">
    <p class="wb-type-label">Category</p>
    <h1>{category.title}</h1>
    <p class="wb-lede">{category.summary}</p>

    <section class="wb-section">
      <h2>Primary Issues</h2>

      {primaryIssues.length > 0 ? (
        <div class="wb-row-list">
          {primaryIssues.map((issue) => (
            <a class="wb-row" href={issue.url}>
              <p class="wb-row-meta">{issue.category_title}</p>
              <h2>{issue.title}</h2>
              <p>{issue.summary}</p>
            </a>
          ))}
        </div>
      ) : (
        <p>No primary issues in this category.</p>
      )}
    </section>

    {secondaryIssues.length > 0 && (
      <section class="wb-section">
        <h2>Also Related Issues</h2>

        {hiddenSecondaryIssueCount > 0 && (
          <p>
            Showing {displayedSecondaryIssues.length} of {secondaryIssues.length} cross-listed issues.
          </p>
        )}

        <div class="wb-row-list">
          {displayedSecondaryIssues.map((issue) => (
            <a class="wb-row" href={issue.url}>
              <p class="wb-row-meta">{issue.category_title}</p>
              <h2>{issue.title}</h2>
              <p>{issue.summary}</p>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>
</WorkbenchLayout>
