---
import WorkbenchLayout from "../../../layouts/WorkbenchLayout.astro";
---

<WorkbenchLayout
  title="Field Notes | PENGO Workbench"
  description="Informal observations, implementation notes, and working notes related to the Workbench."
  url="https://pengosystems.com/workbench/field-notes/"
  active="field-notes"
  breadcrumb="Field Notes"
>
  <article class="wb-content wb-template">
    <p class="wb-type-label">Working Notes</p>
    <h1>Field Notes</h1>
    <p class="wb-lede">
      Informal observations, implementation notes, and working notes related to Workbench usage and development.
    </p>

    <section class="wb-reading-section">
      <h2>Purpose</h2>
      <p>
        Field Notes can document observations, design decisions, migration notes,
        and lessons from using the Workbench. They may cite Issues, Patterns,
        or Lenses, but they do not define canonical ontology entries.
      </p>
    </section>

    <section class="wb-reading-section">
      <h2>Planned Note Types</h2>
      <ul>
        <li>Implementation notes</li>
        <li>Design boundary notes</li>
        <li>Observed usage notes</li>
        <li>Migration notes</li>
        <li>Resolver and machine-output notes</li>
      </ul>
    </section>

    <section class="wb-reading-section">
      <h2>How to Read This</h2>
      <p>
        Field Notes are not canonical Patterns, Lenses, Issues, receipts, or validation rules.
      </p>
    </section>
  </article>
</WorkbenchLayout>
