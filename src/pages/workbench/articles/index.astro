---
import WorkbenchLayout from "../../../layouts/WorkbenchLayout.astro";
---

<WorkbenchLayout
  title="Articles | PENGO Workbench"
  description="Long-form explanatory articles related to Workbench patterns, lenses, issues, and inspection workflows."
  url="https://pengosystems.com/workbench/articles/"
  active="articles"
  breadcrumb="Articles"
>
  <article class="wb-content wb-template">
    <p class="wb-type-label">Long-form Context</p>
    <h1>Articles</h1>
    <p class="wb-lede">
      Long-form explanatory writing related to Workbench concepts, workflows, and system boundaries.
    </p>

    <section class="wb-reading-section">
      <h2>Purpose</h2>
      <p>
        Articles can explain ideas, compare approaches, introduce Workbench concepts,
        and provide deeper context around Patterns, Lenses, Issues, Check Input,
        Explore Results, and machine-readable outputs.
      </p>
    </section>

    <section class="wb-reading-section">
      <h2>Planned Article Types</h2>
      <ul>
        <li>Concept explainers</li>
        <li>Workflow walkthroughs</li>
        <li>Pattern and Lens comparisons</li>
        <li>AI-adjacent failure discussions</li>
        <li>Reference-library design notes</li>
      </ul>
    </section>

    <section class="wb-reading-section">
      <h2>How to Read This</h2>
      <p>
        Articles are explanatory material. They are not canonical Pattern definitions,
        Lens definitions, Issue source-of-truth pages, validator rules, or receipts.
      </p>
    </section>
  </article>
</WorkbenchLayout>
