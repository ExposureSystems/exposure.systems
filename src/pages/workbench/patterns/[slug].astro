---
import WorkbenchLayout from "../../../layouts/WorkbenchLayout.astro";
import ontologyIndex from "../../../content/_meta/ontology-index.json";

export function getStaticPaths() {
  return ontologyIndex.patterns.map((pattern) => ({
    params: { slug: pattern.slug },
    props: { pattern },
  }));
}

const { pattern } = Astro.props;

const primaryLenses = pattern.lenses.primary
  .map((slug) => ontologyIndex.lenses.find((lens) => lens.slug === slug))
  .filter(Boolean);

const secondaryLenses = pattern.lenses.secondary
  .map((slug) => ontologyIndex.lenses.find((lens) => lens.slug === slug))
  .filter(Boolean);

const primaryIssues = pattern.issues.primary
  .map((slug) => ontologyIndex.issues.find((issue) => issue.slug === slug))
  .filter(Boolean);

const supportingIssues = pattern.issues.supporting
  .map((slug) => ontologyIndex.issues.find((issue) => issue.slug === slug))
  .filter(Boolean);
---

<WorkbenchLayout
  title={`${pattern.code} - ${pattern.title} | PENGO Workbench`}
  description={pattern.summary}
  url={`https://pengosystems.com${pattern.url}`}
  active="patterns"
  breadcrumbs={[
    { label: "Patterns", href: "/workbench/patterns/" },
    { label: pattern.title },
  ]}
>
  <article class="wb-content wb-template">
    <p class="wb-type-label" translate="no" class:list={["notranslate"]} lang="en">
      {pattern.code}
    </p>

    <h1>
      <span translate="no" class="notranslate" lang="en">{pattern.title}</span>
    </h1>

    <p class="wb-lede">{pattern.summary}</p>

    <section class="wb-section">
      <h2>Primary Lenses</h2>

      {primaryLenses.length > 0 ? (
        <div class="wb-row-list">
          {primaryLenses.map((lens) => (
            <a class="wb-row" href={lens.url}>
              <p class="wb-row-meta" translate="no" class="notranslate" lang="en">
                {lens.code}
              </p>
              <h2>
                <span translate="no" class="notranslate" lang="en">{lens.title}</span>
              </h2>
              <p>{lens.summary}</p>
            </a>
          ))}
        </div>
      ) : (
        <p>No primary lenses derived.</p>
      )}
    </section>

    {secondaryLenses.length > 0 && (
      <section class="wb-section">
        <h2>Secondary Lenses</h2>

        <div class="wb-row-list">
          {secondaryLenses.map((lens) => (
            <a class="wb-row" href={lens.url}>
              <p class="wb-row-meta" translate="no" class="notranslate" lang="en">
                {lens.code}
              </p>
              <h2>
                <span translate="no" class="notranslate" lang="en">{lens.title}</span>
              </h2>
              <p>{lens.summary}</p>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="wb-section">
      <h2>Primary Issue Matches</h2>

      {primaryIssues.length > 0 ? (
        <div class="wb-row-list">
          {primaryIssues.map((issue) => (
            <a class="wb-row" href={issue.url}>
              <p class="wb-row-meta" translate="no" class="notranslate" lang="en">
                {issue.code}
              </p>
              <h2>{issue.title}</h2>
              <p>{issue.summary}</p>
            </a>
          ))}
        </div>
      ) : (
        <p>No primary issue matches.</p>
      )}
    </section>

    {supportingIssues.length > 0 && (
      <section class="wb-section">
        <h2>Supporting Issue Matches</h2>

        <div class="wb-row-list">
          {supportingIssues.map((issue) => (
            <a class="wb-row" href={issue.url}>
              <p class="wb-row-meta" translate="no" class="notranslate" lang="en">
                {issue.code}
              </p>
              <h2>{issue.title}</h2>
              <p>{issue.summary}</p>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>
</WorkbenchLayout>
