---
import WorkbenchLayout from "../../../layouts/WorkbenchLayout.astro";
import ontologyIndex from "../../../content/_meta/ontology-index.json";

const patterns = ontologyIndex.patterns;
---

<WorkbenchLayout
  title="Patterns | PENGO Workbench"
  description="Canonical structural Patterns in the Workbench ontology."
  url="https://pengosystems.com/workbench/patterns/"
  active="patterns"
  breadcrumb="Patterns"
>
  <article class="wb-content wb-template">
    <p class="wb-type-label">Structural Patterns</p>
    <h1>Patterns</h1>
    <p class="wb-lede">
      Canonical structural forms declared by Workbench Issues and connected to analytical Lenses.
    </p>

    <section class="wb-section" aria-label="Patterns">
      <div class="wb-row-list">
        {patterns.map((pattern) => (
          <a class="wb-row" href={pattern.url}>
            <p class="wb-row-meta" translate="no" class="notranslate" lang="en">
              {pattern.code}
            </p>
            <h2>
              <span translate="no" class="notranslate" lang="en">{pattern.title}</span>
            </h2>
            <p>{pattern.summary}</p>
          </a>
        ))}
      </div>
    </section>
  </article>
</WorkbenchLayout>
