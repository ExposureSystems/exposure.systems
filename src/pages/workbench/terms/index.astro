---
import WorkbenchLayout from "../../../layouts/WorkbenchLayout.astro";
---

<WorkbenchLayout
  title="Workbench Terms | PENGO Workbench"
  description="Terms and boundaries for using the PENGO Workbench reference library."
  url="https://pengosystems.com/workbench/terms/"
  active="terms"
  breadcrumb="Workbench Terms"
>
  <article class="wb-content wb-template">
    <p class="wb-type-label">Terms</p>
    <h1>Workbench Terms</h1>
    <p class="wb-lede">
      Terms and boundaries for using the PENGO Workbench reference library.
    </p>

    <section class="wb-reading-section">
      <h2>Reference Library</h2>
      <p>
        PENGO Workbench is a public reference library for inspecting AI-facing failure
        surfaces, structural Patterns, diagnostic Lenses, and related workflows.
      </p>
      <p>
        Workbench pages are informational references. They are not legal, medical,
        financial, security, or compliance advice.
      </p>
    </section>

    <section class="wb-reading-section">
      <h2>No Final Diagnosis</h2>
      <p>
        Workbench references can help surface related structures. They do not prove
        causality, score a model, validate a prompt, or determine why an AI system failed.
      </p>
    </section>

    <section class="wb-reading-section">
      <h2>Use at Your Own Risk</h2>
      <p>
        You are responsible for how you interpret and apply Workbench references,
        including any decisions made from AI outputs, mapped results, or related pages.
      </p>
    </section>
  </article>
</WorkbenchLayout>
